# Local server port
PORT=8899

# lark-cli executable name or absolute path
LARK_CLI_BIN=lark-cli

# Your local lark-cli profile name
LARK_PROFILE=replace-with-your-profile

# Optional: path to your local source config
SOURCES_CONFIG_PATH=./config/sources.local.json

# Optional: page size per lark-cli sync request
LARK_SYNC_LIMIT=200

# Optional: local CLIProxyAPI base URL for AI tools
AI_PROXY_BASE_URL=http://127.0.0.1:8317

# Optional: local CLIProxyAPI bearer key for AI tools (defaults to cliproxyapi-local)
AI_PROXY_API_KEY=cliproxyapi-local

# Optional: model used by the Dewu image generation tool
AI_DEWU_MODEL=gemini-3.1-flash-image

# Optional: local fixed base image path used as image 1 for Dewu generation (defaults to ./assets/dewu-base-report.jpg)
AI_DEWU_BASE_IMAGE_PATH=./assets/dewu-base-report.jpg

# Optional: timeout for Dewu generation requests in milliseconds
AI_DEWU_TIMEOUT_MS=120000

# Optional: max bytes per uploaded image for Dewu generation
AI_DEWU_MAX_FILE_BYTES=6291456
